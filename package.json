{
  "name": "no3d-tools-website",
  "version": "1.0.0",
  "description": "NO3D Tools website",
  "type": "module",
  "scripts": {
    "test": "npm run test:auth && npm run test:v3",
    "build": "node scripts/update-commit-hash.js",
    "start": "doppler run -- npx vercel dev --listen 3001 --yes",
    "test:auth": "node --test tests/auth-session.test.mjs tests/effective-manifest.test.mjs tests/purchase-flow.test.mjs",
    "test:v3": "node --test tests/v3-ui-contract.test.mjs tests/v3-access.test.mjs tests/account-directory.test.mjs",
    "acceptance:v3": "node scripts/v3-acceptance.mjs",
    "acceptance:v3:commerce": "node scripts/v3-commerce-acceptance.mjs",
    "acceptance:v3:device": "node scripts/v3-device-acceptance.mjs",
    "acceptance:v3:free": "node scripts/v3-free-access-acceptance.mjs",
    "acceptance:v3:membership": "node scripts/v3-membership-acceptance.mjs",
    "acceptance:v3:refund": "node scripts/v3-refund-acceptance.mjs",
    "acceptance:v3:recovery": "node scripts/v3-recovery-acceptance.mjs",
    "env:v3:staging": "node scripts/sync-v3-staging-env.mjs",
    "update-commit": "node scripts/update-commit-hash.js",
    "fix-vercel": "node scripts/fix-vercel-settings.js",
    "fix-vercel:doppler": "doppler run -- node scripts/fix-vercel-settings.js",
    "fix-vercel:cli": "./scripts/fix-vercel-settings-cli.sh",
    "r2:upload": "node scripts/r2-upload-library-blends.mjs",
    "r2:publish-extension": "node scripts/publish-extension.mjs",
    "acceptance:account:production": "node scripts/production-account-smoke.mjs",
    "publish-blog": "node scripts/publish-blog.mjs",
    "publish-blog:dry": "node scripts/publish-blog.mjs --dry-run",
    "publish-blog:force": "node scripts/publish-blog.mjs --force",
    "send-newsletter": "node scripts/send-newsletter.mjs",
    "send-newsletter:dry": "node scripts/send-newsletter.mjs --dry-run",
    "newsletter:list": "node scripts/send-newsletter.mjs --list",
    "newsletter:render": "node scripts/render-email-sections.mjs",
    "newsletter:preview": "node scripts/render-email-sections.mjs --preview"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "@aws-sdk/s3-request-presigner": "^3.758.0",
    "@supabase/supabase-js": "^2.89.0",
    "@vercel/analytics": "^1.3.1",
    "@vercel/functions": "3.4.3",
    "dotenv": "^17.2.3",
    "gray-matter": "^4.0.3",
    "resend": "^4.0.0",
    "stripe": "^16.12.0"
  },
  "devDependencies": {
    "puppeteer": "^25.8.0"
  }
}
